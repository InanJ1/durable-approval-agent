# LLM (OpenAI-compatible; the shared local Ollama by default)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_S=300

# Temporal dev server (scripts/temporal_server.sh starts it in Docker)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# Who the chat user is when raising a request (no SSO in this demo)
DEMO_REQUESTER=ind1.planner@corvane.example

# SQLite stand-in for the ERP (created on first use from data/*.csv)
# CORVANE_DB=var/corvane.sqlite

# Keep the LangGraph dev server local: no LangSmith tracing, no CLI analytics
LANGSMITH_TRACING=false
LANGGRAPH_CLI_NO_ANALYTICS=1
